# Use pglite for an ephemeral local database. Production requires persistent Postgres.
DATABASE_URL=pglite

# Auth (magic-link). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-random
# Comma-separated. Development defaults to admin@example.com when omitted.
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Public origin (used in emails)
APP_URL=http://localhost:3000

# Production magic-link delivery
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=Luma Alt <events@example.com>
